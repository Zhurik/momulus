# Image for the LLM step: pi plus a minimal set of tools.
# Built separately from the service and started once per job.
FROM node:22-slim

# The pi version is pinned: upgrading is a deliberate act.
ARG PI_VERSION=0.87.1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force

# The node image already ships an unprivileged user called node (uid 1000).
ENV HOME=/home/node \
    PI_SKIP_VERSION_CHECK=1 \
    PI_TELEMETRY=0 \
    NODE_ENV=production

# The orchestrator mounts the directories: /work (working copy), /skills (ro), /out (artifacts).
RUN mkdir -p /work /skills /out && chown node:node /work /out

USER node
WORKDIR /work

# The orchestrator supplies the full command.
ENTRYPOINT []
CMD ["pi", "--version"]
