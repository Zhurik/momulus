# Copy to .env and fill in. docker compose reads this file automatically.
#
#   cp .env.example .env
#   just up

# --- required -----------------------------------------------------------------

# GitHub credentials, option A: a personal access token (simplest).
# Fine-grained token at https://github.com/settings/personal-access-tokens with
# Contents RW, Pull requests RW, Issues RW, Metadata R on the repositories you
# want. With a token, `repos` in config.toml must list them explicitly.
GITHUB_TOKEN=

# GitHub credentials, option B: a GitHub App (own identity, hourly tokens).
# Leave GITHUB_TOKEN empty, set the App id here, put the private key at
# ${MOMULUS_ROOT}/secrets/github-app.pem and start with the overlay:
#   docker compose -f docker-compose.yml -f docker-compose.app-auth.yml up -d
# GITHUB_APP_ID=

# LLM provider key.
LLM_API_KEY=

# --- optional -----------------------------------------------------------------

# Endpoint of an OpenAI-compatible gateway (OpenRouter, vLLM, a corporate proxy).
# Leave unset for a provider pi already knows (openai, anthropic, google, ...).
# Must be set when config.toml has `api = "openai-completions"`.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Where data/, skills/ and config.toml live. Defaults to this directory.
# MOMULUS_ROOT=/srv/momulus

# Log level and pinned pi version.
# RUST_LOG=info
# PI_VERSION=0.87.1
